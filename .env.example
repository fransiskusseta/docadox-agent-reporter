# Docadox Agent Reporter v1 — environment configuration.
# Copy this file to .env and fill in real values. NEVER commit the real .env.

# Telegram Bot API credentials. See README.md "Telegram setup" for how to
# obtain these from @BotFather and your own chat id. NAMES ONLY here --
# placeholders below are not real values.
DOCADOX_REPORTER_TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
DOCADOX_REPORTER_TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID

# Localhost-only API bind address/port. Do not change the host away from a
# loopback address unless you fully understand the security implications.
DOCADOX_REPORTER_HOST=127.0.0.1
DOCADOX_REPORTER_PORT=8787

# How often (seconds) the service polls Telegram for inbound replies.
DOCADOX_REPORTER_POLL_INTERVAL_SEC=3

# Comma-separated allowlist of up to 8 agent ids this reporter will accept
# events for and route inbox replies to. Unknown agent ids are rejected.
DOCADOX_REPORTER_AGENT_IDS=claude-1,claude-2,claude-3,claude-4,codex-1,codex-2,copilot-1,copilot-2

# Where SQLite state lives (event log, inbox, Telegram offset). Defaults to
# ./data relative to this project if unset.
# DOCADOX_REPORTER_DATA_DIR=./data

# ── GitHub Cloud Agent Adapter (adapters/github/) ────────────────────────────
# See adapters/github/README.md for full setup steps and required GitHub
# permissions. NAMES ONLY here -- placeholders below are not real values.

# Bearer token used for every GitHub API call this adapter makes. Supply
# EITHER a fine-grained personal access token OR a manually-obtained GitHub
# App user-to-server access token -- both are used identically. A classic
# GitHub App installation token does NOT work for the Agent Tasks API (the
# primary Copilot cloud agent monitoring target) -- GitHub's own docs
# explicitly reject it there. Minimum fine-grained PAT permissions: "Agent
# tasks" (Read), "Issues" (Write, only needed for the reverse-instruction
# comment path), "Pull requests" (Read), "Checks" (Read), "Actions" (Read),
# "Metadata" (Read, mandatory baseline).
DOCADOX_GITHUB_TOKEN=REPLACE_WITH_YOUR_FINE_GRAINED_PAT

# Comma-separated "owner/repo" list this adapter polls via the Agent Tasks API.
DOCADOX_GITHUB_REPOS=REPLACE_WITH_OWNER/REPO

# Which reporter agent_id slot this adapter instance reports as (must already
# be in DOCADOX_REPORTER_AGENT_IDS above).
DOCADOX_GITHUB_ADAPTER_AGENT_ID=copilot-1
DOCADOX_GITHUB_ADAPTER_AGENT_NAME=GitHub Copilot Cloud

# Standard GitHub webhook shared secret (Settings -> Webhooks -> Secret on the
# repo/org, or a GitHub App's own webhook secret). Verified via
# X-Hub-Signature-256 -- a real HMAC-SHA256 signature GitHub itself computes.
DOCADOX_GITHUB_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Copilot Cloud HTTP hook shared secret. NOT a GitHub-issued cryptographic
# signature (GitHub documents none for these hooks) -- set the SAME value
# here and as a custom header in the target repo's own
# .github/hooks/*.json `headers` field (see adapters/github/README.md).
DOCADOX_GITHUB_COPILOT_HOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Where normalized events are sent: "local" (default, posts directly to this
# reporter's own loopback API, full status fidelity, zero extra
# infrastructure) or "gateway" (HMAC-signed to Claude #1's Cloud Gateway
# /v1/cloud/events, for a deployment that cannot reach this machine's
# loopback interface at all. The Gateway preserves the same ten canonical
# statuses as the local Reporter sink.
DOCADOX_GITHUB_ADAPTER_SINK=local
# DOCADOX_REPORTER_BASE_URL=http://127.0.0.1:8787
# DOCADOX_GATEWAY_URL=https://gateway.example
# DOCADOX_GATEWAY_ADAPTER_SECRET=REPLACE_WITH_THE_GATEWAYS_OWN_ADAPTER_SECRET

# Polling cadence (Agent Tasks API has no webhook/push of its own -- see
# adapters/github/README.md "Webhook coverage") and error backoff ceiling.
DOCADOX_GITHUB_ADAPTER_POLL_INTERVAL_SEC=30
DOCADOX_GITHUB_ADAPTER_MAX_BACKOFF_SEC=600

# Webhook/hook receiver bind address. Unlike the reporter core, this MUST be
# reachable from GitHub's public infrastructure -- deploy it behind your own
# TLS-terminating reverse proxy; never expose it directly over plain HTTP.
DOCADOX_GITHUB_ADAPTER_HOST=0.0.0.0
DOCADOX_GITHUB_ADAPTER_PORT=8790

# Separate sqlite file for this adapter's own polling cursor/dedup state
# (never reporter's own reporter.db). Defaults to ./data/github_adapter.db.
# DOCADOX_GITHUB_ADAPTER_STATE_DB=./data/github_adapter.db
